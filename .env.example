# Optional. The site posts to /api/inquiry on its own domain by default (see api/inquiry.js).
# Only set this to test against a different server.
# PUBLIC_FORM_URL=http://localhost:3000/api/inquiry

# Push notifications (see api/_push.js). Generate keys with: npx web-push generate-vapid-keys
# Only the PUBLIC key belongs here/in the frontend. The private key goes in Vercel env vars only.
# PUBLIC_VAPID_PUBLIC_KEY=
