---
import "../styles/global.css";
const { title = "Book Recess", noindex = false } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#1a1033" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Recess" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body>
    <slot />
    <script is:inline>
      // A tapped notification leaves the page it wants in a cache (see public/sw.js); go there.
      (function () {
        function go(url) {
          if (!url) return;
          var target = new URL(url, location.href);
          if (target.pathname === location.pathname) return;
          location.assign(target.href);
        }
        function check() {
          if (!("caches" in window)) return;
          caches.open("recess-pending").then(function (c) {
            return c.match("/pending").then(function (r) {
              if (!r) return;
              return c.delete("/pending").then(function () { return r.text(); }).then(go);
            });
          }).catch(function () {});
        }
        check();
        document.addEventListener("visibilitychange", function () {
          if (document.visibilityState === "visible") check();
        });
        if ("serviceWorker" in navigator) {
          navigator.serviceWorker.addEventListener("message", function (e) {
            if (e.data && e.data.type === "open") go(e.data.url);
          });
        }
      })();
    </script>
  </body>
</html>
