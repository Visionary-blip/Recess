---
import Base from "../layouts/Base.astro";
import BookingForm from "../components/BookingForm.jsx";
import NotifyGate from "../components/NotifyGate.jsx";
const formUrl = import.meta.env.PUBLIC_FORM_URL ?? "/api/inquiry";
---
<Base title="Book Recess">
  <NotifyGate client:load />
  <BookingForm client:load bandName="Recess" formUrl={formUrl} />
</Base>
